VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-your_public_key_here
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your_access_token_here
VITE_MERCADOPAGO_ACCESS_TOKEN=APP_USR-your_access_token_here
